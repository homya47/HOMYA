APP_NAME=HOMYA
# OP-10 : fichiers par défaut ; bascule SQL soumise à une autorisation distincte.
HOMYA_CATALOGUE_SOURCE=files
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Public HOMYA contact details; phone uses international format for calls, WhatsApp and SMS.
HOMYA_CONTACT_PHONE=+33756894951
HOMYA_CONTACT_EMAIL=support@homya.eu

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
DB_DATABASE=homya_local
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_bin
# Renseigner les accès uniquement dans .env ; aucun identifiant n'est présumé.
# Futur runtime : lecteur homya_local_reader après tables/SELECT/bascule autorisés.
# Les accès schema/import restent dans leurs fichiers CLI privés, jamais ici.
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production homya.eu: APP_ENV=production, APP_DEBUG=false, APP_URL=https://homya.eu.
# Override the local SESSION_ENCRYPT=false above with true; set SESSION_SECURE_COOKIE=true.
# Keep SESSION_HTTP_ONLY=true, SESSION_SAME_SITE=lax and SESSION_DOMAIN=null.
# Run php artisan homya:security-audit on the target host before opening traffic.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Commerce: schema and declared initial stock require their separate local installation plan.
HOMYA_COMMERCE_DB_HOST=127.0.0.1
HOMYA_COMMERCE_DB_PORT=3307
HOMYA_COMMERCE_DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
HOMYA_COMMERCE_DB_DATABASE=
HOMYA_COMMERCE_DB_USERNAME=
HOMYA_COMMERCE_DB_PASSWORD=
HOMYA_INVENTORY_ENABLED=false
HOMYA_CHECKOUT_ENABLED=false
HOMYA_DEFERRED_ORDERS_ENABLED=false
HOMYA_COMMERCE_LEGAL_READY=false

# Virement : fournir le RIB professionnel réel avant activation. Réservation fixée à 72 h.
HOMYA_BANK_TRANSFER_ENABLED=false
HOMYA_BANK_BENEFICIARY=
HOMYA_BANK_IBAN=
HOMYA_BANK_BIC=
HOMYA_BANK_NAME=

# Administration locale uniquement ; créer le hash via homya:admin-create.
HOMYA_ADMIN_USERNAME=
HOMYA_ADMIN_PASSWORD_HASH=

# Dashboard de gestion : activer uniquement après le plan SQL dédié.
HOMYA_ADMIN_MANAGEMENT_ENABLED=false
HOMYA_GOOGLE_CLIENT_ID=
HOMYA_GOOGLE_CLIENT_SECRET=
HOMYA_GOOGLE_REFRESH_TOKEN=
HOMYA_GA4_PROPERTY_ID=
HOMYA_GSC_SITE=
HOMYA_GOOGLE_ADS_CUSTOMER_ID=
HOMYA_GOOGLE_ADS_MANAGER_ID=
HOMYA_GOOGLE_ADS_DEVELOPER_TOKEN=
HOMYA_MERCHANT_ACCOUNT_ID=
HOMYA_GTM_CONTAINER_ID=
HOMYA_META_ACCOUNT_ID=
HOMYA_META_ACCESS_TOKEN=
HOMYA_META_API_VERSION=

# SEO : domaine HTTPS exact, puis activation après la recette de production.
HOMYA_PUBLIC_URL=
HOMYA_SEO_INDEXING_ENABLED=false
HOMYA_GOOGLE_SITE_VERIFICATION=
HOMYA_MERCHANT_FEED_ENABLED=false
